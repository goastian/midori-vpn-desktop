{
  "name": "midorivpn-desktop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Secure Midori VPN client for Linux",
  "main": "index.js",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "3.5.42",
    "vue-i18n": "11.4.10",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "5.0.0",
    "@vue/test-utils": "2.5.0",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "glob": "13.0.6"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "build": "npm run typecheck && vite build",
    "build:linux": "npm run build",
    "build:qt-shell": "bash scripts/build-qt-shell.sh",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "rpm:build": "bash scripts/build-rpm.sh",
    "security:tools": "bash scripts/install-security-tools.sh",
    "security:audit": "bash scripts/govulncheck.sh && bash scripts/npm-audit.sh",
    "security:audit:npm": "bash scripts/npm-audit.sh",
    "build-agent": "bash scripts/build-agent.sh linux-amd64",
    "build-agent:host": "bash scripts/build-agent.sh linux-amd64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goastian/midorivpn-desktop.git"
  },
  "keywords": [],
  "author": "Astian, Inc.",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/goastian/midorivpn-desktop/issues"
  },
  "homepage": "https://github.com/goastian/midorivpn-desktop#readme"
}
