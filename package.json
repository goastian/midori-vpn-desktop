{
  "name": "midorivpn-desktop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Secure Midori VPN client for Linux",
  "main": "index.js",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "pinia": "^4.0.3",
    "vue": "3.5.41",
    "vue-i18n": "11.4.9",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "^2.4.11",
    "eslint": "10.9.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "happy-dom": "^20.11.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "glob": "13.0.6"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "build": "npm run typecheck && vite build",
    "build:linux": "npm run typecheck && MIDORIVPN_LINUX_BROWSER_SHELL=1 vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "bash scripts/tauri-build.sh",
    "rpm:build": "bash scripts/build-rpm.sh",
    "appimage:build:local": "bash scripts/build-local-appimage.sh",
    "appimage:run:local": "bash scripts/run-local-appimage.sh",
    "verify:tauri-resources": "node scripts/verify-tauri-resources.mjs",
    "security:tools": "bash scripts/install-security-tools.sh",
    "security:audit": "bash scripts/cargo-audit.sh && bash scripts/govulncheck.sh && bash scripts/npm-audit.sh",
    "security:audit:npm": "bash scripts/npm-audit.sh",
    "build-agent": "bash scripts/build-agent.sh linux-amd64",
    "build-agent:host": "bash scripts/build-agent.sh linux-amd64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goastian/midorivpn-desktop.git"
  },
  "keywords": [],
  "author": "Astian, Inc.",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/goastian/midorivpn-desktop/issues"
  },
  "homepage": "https://github.com/goastian/midorivpn-desktop#readme"
}
