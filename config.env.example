# MidoriVPN Desktop runtime configuration
# Copy to /etc/midorivpn/config.env and replace every placeholder.
API_URL=https://vpn.example.com
ACCOUNT_URL=https://vpn.example.com
AUTHENTIK_ISSUER=https://accounts.example.com/application/o/vpn/
AUTHENTIK_CLIENT_ID=your_public_client_id_here
AUTHENTIK_AUTHORIZATION_URL=https://accounts.example.com/application/o/authorize/
AUTHENTIK_TOKEN_URL=https://accounts.example.com/application/o/token/
AUTHENTIK_USERINFO_URL=https://accounts.example.com/application/o/userinfo/
AUTHENTIK_JWKS_URL=https://accounts.example.com/application/o/vpn/jwks/
AUTHENTIK_REDIRECT_URI=http://127.0.0.1:7071/oauth/callback
