{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MidoriVPN",
  "version": "2.0.0",
  "identifier": "org.astian.midorivpn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MidoriVPN",
        "width": 460,
        "height": 700,
        "resizable": false,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' tauri: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:7071",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: data: blob:",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      }
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "Copyright (C) 2026 Astian, Inc.",
    "homepage": "https://github.com/goastian/midorivpn-desktop",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "longDescription": "MidoriVPN is the Linux desktop client for secure Midori VPN connections. It includes the privileged local agent needed to configure and manage supported VPN transports.",
    "publisher": "Astian, Inc.",
    "shortDescription": "Secure Midori VPN client for Linux",
    "targets": ["rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../agent/target/release/agent": "agent",
      "polkit/org.astian.midorivpn.policy": "polkit/org.astian.midorivpn.policy",
      "polkit/49-midorivpn.rules": "polkit/49-midorivpn.rules",
      "../packaging/apparmor/usr.libexec.midorivpn-agent": "apparmor/usr.libexec.midorivpn-agent",
      "../packaging/selinux/midorivpn.te": "selinux/midorivpn.te",
      "../packaging/selinux/midorivpn.fc": "selinux/midorivpn.fc",
      "../packaging/autostart/midorivpn.desktop": "autostart/midorivpn.desktop",
      "../packaging/launcher/midorivpn.desktop": "launcher/midorivpn.desktop",
      "../config.env.example": "config.env.example",
      "icons/32x32.png": "icons/32x32.png",
      "icons/128x128.png": "icons/128x128.png",
      "icons/128x128@2x.png": "icons/128x128@2x.png"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37", "libcap2-bin"],
        "files": {
          "/usr/share/polkit-1/actions/org.astian.midorivpn.policy": "polkit/org.astian.midorivpn.policy",
          "/etc/polkit-1/rules.d/49-midorivpn.rules": "polkit/49-midorivpn.rules",
          "/etc/apparmor.d/usr.libexec.midorivpn-agent": "../packaging/apparmor/usr.libexec.midorivpn-agent",
          "/usr/share/midorivpn/selinux/midorivpn.te": "../packaging/selinux/midorivpn.te",
          "/usr/share/midorivpn/selinux/midorivpn.fc": "../packaging/selinux/midorivpn.fc"
        },
        "postInstallScript": "../packaging/maintainer/postinst",
        "preRemoveScript": "../packaging/maintainer/prerm"
      },
      "rpm": {
        "depends": ["libcap-progs"],
        "files": {
          "/usr/share/polkit-1/actions/org.astian.midorivpn.policy": "polkit/org.astian.midorivpn.policy",
          "/etc/polkit-1/rules.d/49-midorivpn.rules": "polkit/49-midorivpn.rules",
          "/usr/share/midorivpn/selinux/midorivpn.te": "../packaging/selinux/midorivpn.te",
          "/usr/share/midorivpn/selinux/midorivpn.fc": "../packaging/selinux/midorivpn.fc",
          "/usr/share/doc/midori-vpn/config.env.example": "../config.env.example"
        },
        "postInstallScript": "../packaging/maintainer/postinst",
        "preRemoveScript": "../packaging/maintainer/prerm"
      }
    }
  }
}
