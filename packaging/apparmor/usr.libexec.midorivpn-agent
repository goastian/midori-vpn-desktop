#include <tunables/global>

profile midorivpn-agent /usr/libexec/midorivpn-agent {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>
  #include <abstractions/ssl_certs>
  #include <abstractions/dbus-session-strict>
  #include <abstractions/dbus-strict>

  dbus (send)
    bus=session
    path=/org/freedesktop/secrets{,/**}
    peer=(name=org.freedesktop.secrets),
  dbus (receive)
    bus=session
    path=/org/freedesktop/secrets{,/**}
    peer=(name=org.freedesktop.secrets),
  dbus (send)
    bus=system
    path=/org/freedesktop/resolve1{,/**}
    peer=(name=org.freedesktop.resolve1),

  capability net_admin,
  capability net_raw,

  /dev/net/tun rw,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,

  /usr/libexec/midorivpn-agent mr,
  /usr/share/midorivpn/ui/** r,
  /etc/midorivpn/** r,

  owner @{HOME}/.config/midorivpn/ rw,
  owner @{HOME}/.config/midorivpn/** rwk,
  owner @{HOME}/.local/state/midorivpn/ rw,
  owner @{HOME}/.local/state/midorivpn/** rwk,
  owner @{HOME}/.config/autostart/ rw,
  owner @{HOME}/.config/autostart/midorivpn.desktop rw,
  owner @{HOME}/.config/autostart/.midorivpn-autostart-* rw,
  owner /run/user/[0-9]*/ r,
  owner /run/user/[0-9]*/.midorivpn-* rw,
  owner /run/user/[0-9]*/midorivpn-agent.lock rwk,
  owner /run/user/[0-9]*/midorivpn-agent.token rwk,
  owner /run/user/[0-9]*/midorivpn-launch.html rwk,
  owner /run/user/[0-9]*/midorivpn-pki-*/ rw,
  owner /run/user/[0-9]*/midorivpn-pki-*/** rwk,

  /usr/sbin/iptables rix,
  /usr/sbin/ip6tables rix,
  /usr/sbin/ip rix,
  /usr/bin/ip rix,
  /usr/sbin/sysctl rix,
  /usr/bin/sysctl rix,
  /usr/bin/firewall-cmd rix,
  /usr/sbin/ufw rix,
  /usr/sbin/nft rix,
  /usr/sbin/openvpn rix,
  /usr/libexec/ipsec/charon rix,
  /usr/lib/ipsec/charon rix,
  /usr/libexec/ipsec/charon-systemd rix,
  /usr/lib/ipsec/charon-systemd rix,
  /usr/sbin/swanctl rix,
  /usr/bin/swanctl rix,
  /etc/strongswan.d/** r,
  /usr/lib64/ipsec/** mr,
  /usr/bin/resolvectl rix,
  /bin/resolvectl rix,
  /usr/sbin/getcap rix,
  /usr/bin/getcap rix,
  /sbin/getcap rix,
  /bin/getcap rix,
  /usr/bin/systemctl rix,
  /bin/systemctl rix,
  /usr/bin/pkexec Pixr,
  /usr/bin/xdg-open rix,

  /etc/resolv.conf r,
  /proc/sys/net/ipv4/ip_forward rw,
  /proc/sys/net/ipv6/conf/*/forwarding rw,
  /proc/*/net/route r,
  /proc/*/net/fib_trie r,
  /proc/sys/kernel/random/uuid r,
  /proc/sys/net/core/somaxconn r,
  /proc/cpuinfo r,
  /proc/meminfo r,
  /proc/stat r,
  /proc/self/** r,
  /sys/class/net/midorivpn-ovpn/statistics/* r,
  /sys/class/net/midorivpn-ike/statistics/* r,
}
