FROM docker.io/library/node:24.22.3-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 AS node_runtime

RUN npm install --global npm@12.2.2

FROM docker.io/library/golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS go_runtime

FROM docker.io/library/fedora:44@sha256:15da97ed9aa94dd3d92c3925eb89520f6c80e07ea7ee24cba848d1f8b6912b3e

COPY --from=node_runtime /usr/local/ /usr/local/
COPY --from=go_runtime /usr/local/go /usr/local/go

RUN dnf install -y --setopt=install_weak_deps=False \
    cmake gcc-c++ qt6-qtbase-devel rpm-build git file && \
    dnf clean all

ENV GOTOOLCHAIN=local \
    PATH=/usr/local/go/bin:/usr/local/bin:$PATH

WORKDIR /src
