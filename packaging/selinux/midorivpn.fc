# MidoriVPN agent — SELinux file context.
#
# Installed via package post-install:
#   semanage fcontext -a -t bin_t '/usr/libexec/midorivpn-agent'
#   restorecon -v /usr/libexec/midorivpn-agent
#
# (The .te policy module below grants the relevant transitions.)
/usr/libexec/midorivpn-agent                --      system_u:object_r:bin_t:s0
/etc/midorivpn(/.*)?                                system_u:object_r:etc_t:s0
/usr/share/polkit-1/actions/org\.astian\.midorivpn\.policy --  system_u:object_r:usr_t:s0
