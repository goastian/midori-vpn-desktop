## <summary>MidoriVPN privileged agent.</summary>
##
## The agent runs as the invoking user with file capabilities
## (cap_net_admin,cap_net_raw=ep) set on the binary, so SELinux sees it as
## a regular user-domain process executing /usr/libexec/midorivpn-agent.
##
## This module is intentionally minimal: it grants the rules needed for the
## agent to open /dev/net/tun and load WireGuard kernel state via netlink.
## Binding the unprivileged loopback ports needs no SELinux exception. We do NOT define
## a separate domain transition — the agent binary stays in the user's
## domain because all privileged operations are gated by file capabilities,
## not by setuid.

module midorivpn 1.0;

require {
    type unconfined_t;
    type user_t;
    type tun_tap_device_t;
    class chr_file { read write open ioctl };
    class capability { net_admin net_raw dac_override linux_immutable };
}

# Allow the user-domain process to manipulate the TUN device.
allow user_t tun_tap_device_t:chr_file { read write open ioctl };
allow unconfined_t tun_tap_device_t:chr_file { read write open ioctl };

# Permit the file capabilities used for WireGuard and firewall management.
allow user_t self:capability { net_admin net_raw dac_override linux_immutable };
allow unconfined_t self:capability { net_admin net_raw dac_override linux_immutable };
