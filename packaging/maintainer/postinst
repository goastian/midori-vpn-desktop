#!/usr/bin/env bash
set -Eeuo pipefail

warn() {
  printf 'MidoriVPN warning: %s\n' "$*" >&2
}

AGENT="/usr/libexec/midorivpn-agent"
OLD_AGENT="/usr/local/bin/midorivpn-agent"
APPARMOR_PROFILE="/etc/apparmor.d/usr.libexec.midorivpn-agent"
OLD_APPARMOR_PROFILE="/etc/apparmor.d/usr.local.bin.midorivpn-agent"
OLD_PACKAGED_APPARMOR_PROFILE="/usr/lib/MidoriVPN/apparmor/usr.local.bin.midorivpn-agent"
SELINUX_DIR="/usr/share/midorivpn/selinux"

install -d -m 0755 -o root -g root /etc/midorivpn
chmod 0644 /etc/midorivpn/launcher.env
if [[ -f /etc/midorivpn/config.env ]]; then
  chmod 0644 /etc/midorivpn/config.env
fi

# Remove the unmanaged compatibility copy created by pre-2.0 Linux packages.
if [[ -e "$OLD_AGENT" ]]; then
  if command -v setcap >/dev/null 2>&1 && command -v getcap >/dev/null 2>&1 && getcap "$OLD_AGENT" 2>/dev/null | grep -q '='; then
    setcap -r "$OLD_AGENT" >/dev/null 2>&1 || warn "could not revoke capabilities from obsolete agent copy"
  fi
  rm -f -- "$OLD_AGENT"
fi
for old_profile in "$OLD_APPARMOR_PROFILE" "$OLD_PACKAGED_APPARMOR_PROFILE"; do
  [[ -e "$old_profile" ]] || continue
  if command -v apparmor_parser >/dev/null 2>&1; then
    apparmor_parser -R "$old_profile" >/dev/null 2>&1 || warn "could not unload obsolete AppArmor profile"
  fi
  if [[ "$old_profile" == "$OLD_APPARMOR_PROFILE" ]]; then
    rm -f -- "$old_profile"
  fi
done

# A new package inode must never inherit privileges without fresh consent.
if command -v setcap >/dev/null 2>&1; then
  setcap -r "$AGENT" >/dev/null 2>&1 || true
fi

if command -v apparmor_parser >/dev/null 2>&1 && [[ -f "$APPARMOR_PROFILE" ]]; then
  apparmor_parser -r "$APPARMOR_PROFILE" >/dev/null 2>&1 || warn "could not load AppArmor profile"
fi

if [[ "$(cat /sys/fs/selinux/enforce 2>/dev/null || true)" == "1" ]]; then
  if ! command -v checkmodule >/dev/null 2>&1 || ! command -v semodule_package >/dev/null 2>&1 || ! command -v semodule >/dev/null 2>&1; then
    warn "SELinux is enforcing but checkpolicy/policycoreutils are unavailable"
  elif ! (
    work_dir="$(mktemp -d /var/tmp/midorivpn-selinux.XXXXXX)"
    trap 'rm -rf -- "$work_dir"' EXIT
    checkmodule -M -m -o "$work_dir/midorivpn.mod" "$SELINUX_DIR/midorivpn.te"
    semodule_package -o "$work_dir/midorivpn.pp" -m "$work_dir/midorivpn.mod" -f "$SELINUX_DIR/midorivpn.fc"
    semodule -i "$work_dir/midorivpn.pp"
  ) >/dev/null 2>&1; then
    warn "could not install optional SELinux module"
  fi
fi
if command -v semodule >/dev/null 2>&1 && semodule -l 2>/dev/null | grep -Eq '^midorivpn-polkit([[:space:]]|$)'; then
  semodule -r midorivpn-polkit >/dev/null 2>&1 || warn "could not remove legacy SELinux module"
fi
if command -v restorecon >/dev/null 2>&1; then
  restorecon "$AGENT" >/dev/null 2>&1 || warn "could not restore SELinux context on agent"
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl reload polkit.service >/dev/null 2>&1 || systemctl restart polkit.service >/dev/null 2>&1 || warn "could not reload Polkit"
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -qf /usr/share/icons/hicolor >/dev/null 2>&1 || warn "could not refresh icon cache"
fi
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database /usr/share/applications >/dev/null 2>&1 || warn "could not refresh desktop database"
fi

exit 0
