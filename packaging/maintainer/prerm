#!/usr/bin/env bash
set -Eeuo pipefail

warn() {
  printf 'MidoriVPN warning: %s\n' "$*" >&2
}

# RPM passes 1 during upgrades and 0 for final removal.
if [[ "${1:-0}" -ne 0 ]]; then
  exit 0
fi

AGENT="/usr/libexec/midorivpn-agent"
APPARMOR_PROFILE="/etc/apparmor.d/usr.libexec.midorivpn-agent"

if command -v setcap >/dev/null 2>&1 && command -v getcap >/dev/null 2>&1 && [[ -e "$AGENT" ]]; then
  if getcap "$AGENT" 2>/dev/null | grep -q '='; then
    setcap -r "$AGENT" >/dev/null 2>&1 || warn "could not revoke agent capabilities"
  fi
fi
if command -v apparmor_parser >/dev/null 2>&1 && [[ -f "$APPARMOR_PROFILE" ]]; then
  apparmor_parser -R "$APPARMOR_PROFILE" >/dev/null 2>&1 || warn "could not unload AppArmor profile"
fi
if command -v semodule >/dev/null 2>&1 && semodule -l 2>/dev/null | grep -Eq '^midorivpn([[:space:]]|$)'; then
  semodule -r midorivpn >/dev/null 2>&1 || warn "could not remove SELinux module"
fi

exit 0
